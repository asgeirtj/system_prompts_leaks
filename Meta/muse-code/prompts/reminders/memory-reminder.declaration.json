        },
        "effectivePriority": {
          "effective": "clampedPriority"
        },
        "kind": {
          "literal": "memory"
        },
        "memoryEvidence": {
          "validator": "memory_refs.proposal_refs"
        },
        "reason": {
          "literal": "duplicate_memory_reminder"
