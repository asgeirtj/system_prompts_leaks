        },
        "memoryEvidence": {
          "validator": "memory_refs.proposal_refs"
        },
        "reason": {
          "literal": "already_read_by_main_agent"
        },
        "rejection": {
          "literal": "already_read_by_main_agent"
        },
        "requestedPriority": {
          "fallback": {
            "effective": "defaultPriority"
          },
          "field": "priority"
        },
        "skillEvidence": {
          "literal": null
        },
        "subject": {
          "validator": "memory_refs.proposal_refs"
        },
        "visibleForSteps": {
          "fallback": {
            "literal": 1
          },
          "field": "visible_for_steps"
        }
      },
      "duplicate_memory_reminder": {
        "body": {
