      },
      "effectivePriority": {
        "effective": "clampedPriority"
      },
      "kind": {
        "literal": "memory"
      },
      "memoryEvidence": {
        "validator": "memory_refs.install_refs"
      },
      "reason": {
        "field": "reason"
      },
      "rejection": {
        "literal": null
      },
      "requestedPriority": {
        "fallback": {
          "effective": "defaultPriority"
        },
        "field": "priority"
      },
      "skillEvidence": {
        "literal": null
      },
      "subject": {
        "validator": "memory_refs.proposal_refs"
      },
      "visibleForSteps": {
        "fallback": {
          "literal": 1
        },
        "field": "visible_for_steps"
      }
    },
    "roundEnded": {
      "body": {
        "literal": ""
      },
      "effectivePriority": {
