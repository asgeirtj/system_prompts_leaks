        }
      },
      "name": "memory_body",
      "outputs": {
        "advisory_block": "string",
        "proposal_advisory": "string",
        "rendered_refs": "string"
      },
      "version": 1
    },
    {
      "id": "memory_source_refs",
      "inputs": {
